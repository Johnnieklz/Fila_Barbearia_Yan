# Copie este arquivo para .env.local e preencha com as chaves do seu projeto Supabase.
# Encontre esses valores em: Supabase Dashboard > Project Settings > API

# URL pública do projeto Supabase (só a URL base, sem /rest/v1/ no final)
NEXT_PUBLIC_SUPABASE_URL=

# Chave publica (anon key) - segura para expor no frontend, protegida pelo RLS
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave de serviço (service role) - NUNCA exponha no frontend.
# Usada apenas em rotas de servidor (app/api) que precisem ignorar RLS,
# por exemplo, o trigger de criação de perfil ou tarefas administrativas.
SUPABASE_SERVICE_ROLE_KEY=

# URL pública onde o site está publicado, sem barra no final.
# Usada para montar o link/QR Code da fila (ex: https://dominio.com/fila/slug).
# Em desenvolvimento local, use http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
